[
  { "id": "diff-x2", "args": { "operation": "diff", "expr": "x^2" }, "expect": ["2*x"] },
  { "id": "diff-sin", "args": { "operation": "diff", "expr": "sin(x)" }, "expect": ["cos(x)"] },
  { "id": "diff-x3", "args": { "operation": "diff", "expr": "x^3" }, "expect": ["3*x**2"] },
  { "id": "integrate-x", "args": { "operation": "integrate", "expr": "x" }, "expect": ["x**2/2"] },
  { "id": "integrate-def", "args": { "operation": "integrate", "expr": "x^2", "lower": "0", "upper": "1" }, "expect": ["1/3"] },
  { "id": "integrate-sin", "args": { "operation": "integrate", "expr": "sin(x)" }, "expect": ["-cos(x)"] },
  { "id": "solve-quadratic", "args": { "operation": "solve", "expr": "x^2-4=0" }, "expect": ["-2", "2"] },
  { "id": "solve-linear", "args": { "operation": "solve", "expr": "2*x+3=7" }, "expect": ["2"] },
  { "id": "limit-sinc", "args": { "operation": "limit", "expr": "sin(x)/x", "point": "0" }, "expect": ["1"] },
  { "id": "limit-e", "args": { "operation": "limit", "expr": "(1+1/x)^x", "point": "oo" }, "expect": ["E"] },
  { "id": "factor-diff-squares", "args": { "operation": "factor", "expr": "x^2-1" }, "expect": ["x - 1", "x + 1"] },
  { "id": "simplify-rational", "args": { "operation": "simplify", "expr": "(x^2-1)/(x-1)" }, "expect": ["x + 1"] },
  { "id": "expand-square", "args": { "operation": "expand", "expr": "(x+1)^2" }, "expect": ["x**2", "2*x"] },
  { "id": "det-2x2", "args": { "operation": "det", "matrix": "[[1,2],[3,4]]" }, "expect": ["-2"] },
  { "id": "evaluate-x2", "args": { "operation": "evaluate", "expr": "x^2+1", "subs": { "x": "2" } }, "expect": ["5"] },
  { "id": "dot-vectors", "args": { "operation": "dot", "vectors": "[[1,2],[3,4]]" }, "expect": ["11"] },
  { "id": "norm-vector", "args": { "operation": "norm", "vectors": "[[3,4]]" }, "expect": ["5"] }
]
